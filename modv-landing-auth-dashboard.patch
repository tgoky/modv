+# Required in production. Generate one with: openssl rand -base64 32
+SESSION_SECRET=
+
+# Optional. Real-time currency quotes from Twelve Data (https://twelvedata.com).
+# Without it the board falls back to the ECB's daily reference rates and says so.
+# The free plan allows 800 requests a day, which is why /api/fx caches responses.
+TWELVE_DATA_API_KEY=
+
+# Optional. Seconds to cache live currency quotes (minimum 5, default 90).
+FX_CACHE_SECONDS=
+
+# Optional. Where the development user store is written (default: ./.data).
+USER_STORE_DIR=
