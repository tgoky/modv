-+      }
-+    };
-+
-+    const onVisibility = () => {
-+      if (!document.hidden) {
-+        clearTimeout(timer);
-+        void run();
-+      }
-+    };
-+    document.addEventListener("visibilitychange", onVisibility);
-+    void run();
-+
-+    return () => {
-+      disposed = true;
-+      clearTimeout(timer);
-+      document.removeEventListener("visibilitychange", onVisibility);
-+    };
-+  }, []);
-+
-+  return { quotes, feed, fx };
-+}
