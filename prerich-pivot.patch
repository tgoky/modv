-+  const series = useMemo(() => {
-+    const lastHistory = points.length ? points[points.length - 1][0] : 0;
-+    return [...points, ...tail.filter((p) => p[0] > lastHistory)];
-+  }, [points, tail]);
-+
-+  const wrapRef = useRef<HTMLDivElement>(null);
-+  const [width, setWidth] = useState(0);
